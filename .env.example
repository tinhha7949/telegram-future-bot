# Telegram (BOT_TOKEN and CHAT_ID are also accepted for compatibility)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MongoDB Atlas or self-hosted MongoDB
MONGO_URI=
MONGO_DB_NAME=market_intelligence

# Optional exact broker XAUUSDm quote endpoint.
# The endpoint must return JSON containing one of: price, last, close, regularMarketPrice.
XAUUSD_PRICE_URL=

# Optional: override the default config file
CONFIG_PATH=config.json
