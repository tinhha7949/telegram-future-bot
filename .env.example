# Nine-AI canonical strategy uses fully closed 4h candles.
# Risk is FIXED in index.js at 0.75% of equity per trade:
# const RISK_PER_TRADE = 0.0075
# RISK_PER_TRADE and MAX_RISK_PER_TRADE environment overrides are intentionally ignored.
# Maximum simultaneous real open positions (runtime accepts 1..50).
MAX_ACTIVE_POSITIONS=20

# Estimated round-trip fees in percentage points, used by AI-9 net-edge calculation.
ROUND_TRIP_FEE_PCT=0.1
