# Nine-AI Futures 4h strategy risk limits
# These bound position sizing and do not override the 9-AI entry/SL/TP plan.
# Fractions: 0.0075 = 0.75% of account equity. The code enforces this fixed risk.
RISK_PER_TRADE=0.0075
MAX_RISK_PER_TRADE=0.0075

# Maximum notional position value as a fraction of account balance.
MAX_POSITION_PERCENT=1.0

# Maximum simultaneous real open positions.
MAX_ACTIVE_POSITIONS=20
