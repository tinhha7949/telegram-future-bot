# Required runtime secrets. Never commit a real .env file.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/trading?retryWrites=true&w=majority
BINANCE_KEY=YOUR_BINANCE_API_KEY
BINANCE_SECRET=YOUR_BINANCE_API_SECRET
# Telegram 1: confirmed entries and /status commands.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Telegram 2: WIN/LOSS results and operational alerts (falls back to Telegram 1).
BOT_TOKEN_2=
AI_CHAT_ID=

# Nine-AI strategy and risk thresholds are read from CONFIG.yaml, not .env.
# The drawdown starting equity is the live exchange equity at first BOT_RUN_V2
# activation; CONFIG.EQUITY_START is NOT used as the drawdown baseline.
# Systemd restarts preserve the current session and its risk circuit latch.

# Estimated round-trip fees in percentage points, used by AI-9 net-edge calculation.
ROUND_TRIP_FEE_PCT=0.1
