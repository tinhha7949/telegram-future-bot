# Required runtime secrets. Never commit a real .env file.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/trading?retryWrites=true&w=majority
BINANCE_KEY=YOUR_BINANCE_API_KEY
BINANCE_SECRET=YOUR_BINANCE_API_SECRET
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional secondary Telegram destination.
BOT_TOKEN_2=
AI_CHAT_ID=

# Nine-AI canonical strategy uses fully closed 4h candles.
# Manually set per-trade equity risk by editing the numeric literal in index.js:
# const RISK_PER_TRADE = 0.0075  # 0.75% of equity; 0.01 means 1%
# .env values do not override this constant.

# Estimated round-trip fees in percentage points, used by AI-9 net-edge calculation.
ROUND_TRIP_FEE_PCT=0.1
